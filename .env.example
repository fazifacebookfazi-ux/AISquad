# Contact form delivery (Resend — https://resend.com)
# Without these the form validates and logs, but does not send email.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=AISquadX <hello@aisquadx.tech>
# Where enquiries land. Defaults to site.email if unset.
CONTACT_TO_EMAIL=hello@aisquadx.tech
